use flake

# where the app will serve static assets from
export STATIC_ASSET_DIR=${PRJ_ROOT:-.}/assets
# where the app will load the CSS from (put here by tailwind)
export STYLESHEET_PATH=/tmp/blog.css
# where the app will load posts from
export POSTS_DIR=${PRJ_ROOT:-.}/content/posts
# where the app will load posts from
export TIDBITS_DIR=${PRJ_ROOT:-.}/content/tidbits
# where the app will dump analytics
export ANALYTICS_DB_PATH=/tmp/blog-analytics.db
export ANALYTICS_DB_URL="sqlite://$ANALYTICS_DB_PATH?mode=rwc"
